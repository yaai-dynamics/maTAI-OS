# ---------------------------------------------------------------------------
# maTAI — environment
# ---------------------------------------------------------------------------
# Copy to .env and adjust. The AI layer still runs offline by default.
# Never put secrets in NEXT_PUBLIC_* variables: they are shipped to the browser.

# Deterministic seeded data + visible demo-data labelling.
DEMO_MODE=true

# AI provider: "mock" (deterministic, offline) | "anthropic" | "openai" | "gemini"
# A live provider only rewrites the prose; figures always come from app code.
# A provider named here without its key runs as "mock". Server-side only.
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# From Google AI Studio. On the free tier Google may use prompts to improve its
# products; use a paid key before any real (non-demo) data goes through it.
# With Gemini, the trip planner also runs a Google Search grounded request per
# plan, for places that are not partners. Only area names are sent. Each
# search is a billed call; results are cached and limited per visitor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Image generation for AI landing pages (src/lib/ai/image-provider.ts). Used
# only when AI_PROVIDER=gemini; every other provider, or no key, falls back to
# the deterministic scene art with no network call.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# MySQL connection. The schema needs InnoDB (foreign keys + transactions);
# migrations pin the engine themselves via scripts/enforce-innodb.mjs, so a
# server defaulting to MyISAM (WAMP does) is not a problem.
# DATABASE_URL="mariadb://root@127.0.0.1:3306/manipur_tourism"
DATABASE_URL="mariadb://maTAIweb:maTAIweb%232026@64.227.131.3:3306/manipur_tourism?allowPublicKeyRetrieval=true"
# Absolute origin printed into destination QR codes.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Payments — Razorpay. Server-side only; never prefix these with NEXT_PUBLIC_.
# Use test-mode keys (rzp_test_...) from Dashboard > Account & Settings > API Keys,
# with the dashboard switched to Test Mode. Left empty, booking requests still
# work but payment is switched off. A live key (rzp_live_...) is refused unless
# PAYMENTS_ALLOW_LIVE=true.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional. Set when a webhook points at /api/payments/razorpay (needs a public
# URL). Without it the booking page reconciles with Razorpay itself.
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_ALLOW_LIVE=false

# Seed generated tourist signals (interactions, feedback, availability,
# enquiries). Defaults to DEMO_MODE. Set false so a real deployment starts
# with only what its own telemetry intake records.
# SEED_SYNTHETIC_SIGNALS=false
