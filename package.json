{
  "name": "matai",
  "version": "0.1.0",
  "private": true,
  "description": "maTAI — AI tourism intelligence for Manipur (Explore Manipur / Decision Room / Create for Manipur)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate": "prisma migrate dev --create-only && node scripts/enforce-innodb.mjs && prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.15.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "4.1.13",
    "tsx": "^4.23.15",
    "typescript": "5.9.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2",
    "mariadb": "^3.5.4"
  }
}
